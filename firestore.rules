rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Replace with the staff accounts for THIS warehouse Firebase project.
    // This project is intentionally separate from the Sales (1C) app's
    // Firebase project — don't reuse that allowlist or merge the data.
    function isStaff() {
      return request.auth != null
        && request.auth.token.email in [
          'REPLACE_WITH_STAFF_EMAIL_1',
          'REPLACE_WITH_STAFF_EMAIL_2'
        ];
    }

    // Real warehouse data: cost prices, suppliers. Staff only.
    match /items/{id} {
      allow read, write: if isStaff();
    }
    match /stock/{id} {
      allow read, write: if isStaff();
    }

    // Public storefront mirror: only the safe subset of fields the admin
    // app writes here (see syncItemToCatalog/syncStockToCatalog in
    // warehouse.html). Anyone may read; only staff may write.
    match /catalog_devices/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /catalog_stock/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
